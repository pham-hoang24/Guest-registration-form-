# Required in production
VITE_API_BASE_URL=/api
VITE_APP_BASE_URL=https://your-app.example.com

# Optional: dev owner JWT for testing owner APIs without OIDC
# VITE_DEV_OWNER_TOKEN=eyJ...

# Optional: OIDC (Phase 2)
# VITE_OIDC_ISSUER=https://auth.example.com
# VITE_OIDC_CLIENT_ID=your-client-id
# VITE_OIDC_REDIRECT_URI=https://your-app.example.com/callback
