# Copy to .env and adjust for local development.
NODE_ENV=development

# PostgreSQL (docker compose up -d starts this)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/guest_registration

# Owner-dashboard JWT (HS256, dev only — rotate and store in a secret manager for prod)
JWT_SECRET=dev_change_me
JWT_ISSUER=guest-registration-platform
JWT_AUDIENCE=owner-dashboard

# URLs
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Storage: "local" for MVP; Azure Blob adapter is the intended prod provider.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.local-storage

# KMS: "local" for MVP; Azure Key Vault adapter is the intended prod provider.
KMS_PROVIDER=local
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_MASTER_KEY_BASE64=replace_with_32_bytes_base64

# Azure (unused while providers are "local")
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=
AZURE_KEY_VAULT_URL=
AZURE_KEY_VAULT_KEY_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Retention
RETENTION_DEFAULT_DAYS=365
