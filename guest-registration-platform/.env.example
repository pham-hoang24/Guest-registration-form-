# Copy to .env and adjust for local development.
NODE_ENV=development

# PostgreSQL (docker compose up -d starts this)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/guest_registration

# Owner-dashboard JWT (HS256, dev only — rotate and store in a secret manager for prod)
JWT_SECRET=dev_change_me
JWT_ISSUER=guest-registration-platform
JWT_AUDIENCE=owner-dashboard
# Owner session lifetime (jsonwebtoken format, e.g. 4h, 30m, 1d).
JWT_EXPIRES_IN=4h

# Set to an https JWKS endpoint to verify owner tokens via RS256 instead of HS256.
# When set, HS256 tokens are rejected outright (no downgrade fallback).
OWNER_JWKS_URI=
# Bearer header accepted for owner auth in addition to the session cookie.
# Defaults to true outside production, false in production — set explicitly to override.
ALLOW_BEARER_OWNER_AUTH=
# Name of the httpOnly owner session cookie.
OWNER_COOKIE_NAME=gr_owner_session
# Sets the cookie's `secure` attribute outside production (defaults to false, i.e.
# insecure, for local HTTP dev). "true" or "false" only. In production the cookie
# is ALWAYS secure regardless of this var — it can only opt in outside prod, never
# opt out in prod. Does not unblock testing the production Docker image over plain
# HTTP; use an HTTPS dev proxy for that.
OWNER_COOKIE_SECURE=

# URLs
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Storage: "local" (dev) or "azure-blob" (production).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.local-storage

# KMS: "local" (dev) or "azure-key-vault" (production).
KMS_PROVIDER=local
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_MASTER_KEY_BASE64=replace_with_32_bytes_base64

# Azure Blob (required when STORAGE_PROVIDER=azure-blob; container must exist)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=

# Azure Key Vault (required when KMS_PROVIDER=azure-key-vault; RSA key, wrap algorithm RSA-OAEP-256)
AZURE_KEY_VAULT_URL=
AZURE_KEY_VAULT_KEY_NAME=
# Optional: pin wrapping to one key version; unset = latest at wrap time.
AZURE_KEY_VAULT_KEY_VERSION=
# DefaultAzureCredential picks these up (or use managed identity in Azure).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Queue: "in-process" (dev: PDF jobs run inside the API request) or
# "azure-service-bus" (production: API enqueues, worker consumes).
QUEUE_PROVIDER=in-process
AZURE_SERVICE_BUS_CONNECTION_STRING=
PDF_QUEUE_NAME=pdf-jobs
# Max Service Bus delivery attempts before a PDF job is dead-lettered.
PDF_JOB_MAX_DELIVERY_COUNT=5

# Retention cleanup schedule (worker process)
RETENTION_INTERVAL_HOURS=24

# Retention
RETENTION_DEFAULT_DAYS=365
