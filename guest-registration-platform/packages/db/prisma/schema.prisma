generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum OwnerRole {
  OWNER
  MANAGER
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RegistrationLinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum GuestSubmissionStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum PassengerCardStatus {
  SUBMITTED
  PDF_READY
  FAILED
}

enum PdfJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LegalBasis {
  LEGAL_OBLIGATION
  CONTRACT
  CONSENT
}

enum ActorType {
  GUEST
  OWNER
  SYSTEM
}

enum AuditAction {
  GUEST_REGISTRATION_SUBMITTED
  PASSENGER_CARD_SUBMITTED
  GUEST_SIGNATURE_SUBMITTED
  PDF_JOB_CREATED
  PDF_GENERATED
  PDF_GENERATION_FAILED
  OWNER_LOGIN_SUCCEEDED
  OWNER_LOGIN_FAILED
  OWNER_VIEWED_SUBMISSION
  OWNER_DOWNLOADED_PDF
  RETENTION_DELETED_SUBMISSION
  OWNER_USER_CREATED
  OWNER_USER_ROLE_CHANGED
  OWNER_USER_DISABLED
  OWNER_USER_ENABLED
  PDF_DECRYPT_FAILED
  PDF_INTEGRITY_FAILED
  UNAUTHORIZED_ACCESS_ATTEMPT
  REGISTRATION_LINK_REGENERATED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             OwnerUser[]
  properties        Property[]
  registrationLinks RegistrationLink[]
  guestSubmissions  GuestSubmission[]
  encryptedPdfs     EncryptedPdf[]
}

model OwnerUser {
  id           String     @id @default(uuid())
  tenantId     String
  email        String     @unique
  passwordHash String
  role         OwnerRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Property {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  countryCode  String
  businessId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  registrationLinks RegistrationLink[]
  guestSubmissions  GuestSubmission[]

  @@index([tenantId])
}

model RegistrationLink {
  id         String                 @id @default(uuid())
  tenantId   String
  propertyId String
  /// SHA-256 hex of the raw token. The raw token is never stored.
  tokenHash  String                 @unique
  status     RegistrationLinkStatus @default(ACTIVE)
  expiresAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  property        Property         @relation(fields: [propertyId], references: [id])
  guestSubmission GuestSubmission?

  @@index([tenantId, propertyId])
}

model GuestSubmission {
  id                    String                @id @default(uuid())
  tenantId              String
  propertyId            String
  registrationLinkId    String                @unique
  status                GuestSubmissionStatus @default(OPEN)
  arrivalDate           DateTime              @db.Date
  departureDate         DateTime?             @db.Date
  departureDateKnown    Boolean               @default(true)
  purposeOfStay         String?
  requirementVersion    String
  maxPassengerCards     Int                   @default(20)
  /// Set on first card submit when PII arrives; null until then.
  retainUntil           DateTime?
  deleteAfter           DateTime?
  /// Soft-delete marker for retention purge.
  deletedAt             DateTime?
  legalBasis            LegalBasis            @default(LEGAL_OBLIGATION)
  /// Contact info copied from primary card holder on first submit; wiped on retention purge.
  primaryGuestName      String?
  primaryGuestEmail     String?
  primaryGuestPhoneE164 String?
  submittedAt           DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  property         Property         @relation(fields: [propertyId], references: [id])
  registrationLink RegistrationLink @relation(fields: [registrationLinkId], references: [id])
  passengerCards   PassengerCard[]

  @@index([tenantId, propertyId])
  @@index([deleteAfter])
  @@index([deletedAt])
}

model PassengerCard {
  id                      String              @id @default(uuid())
  guestSubmissionId       String
  /// Denormalized for authz / querying without joining through submission.
  tenantId                String
  propertyId              String
  cardNumber              Int
  cardType                String
  countryOfEntryToFinland String?
  /// Explicit reason the country-of-entry is blank: RESIDENT_IN_FINLAND (no Nordic exemption).
  countryOfEntryNotApplicableReason String?
  cardHolderName          String?
  cardHolderEmail         String?
  cardHolderPhoneE164     String?
  /// HMAC-SHA256(FINGERPRINT_PEPPER, normalizedCardJson) — plaintext credentials never included.
  submissionFingerprint   String
  status                  PassengerCardStatus @default(SUBMITTED)
  requirementVersion      String
  submittedAt             DateTime            @default(now())
  signedAt                DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  guestSubmission GuestSubmission        @relation(fields: [guestSubmissionId], references: [id], onDelete: Cascade)
  guests          Guest[]
  signature       PassengerCardSignature?
  pdfJob          PdfJob?
  encryptedPdf    EncryptedPdf?

  @@unique([guestSubmissionId, submissionFingerprint])
  @@index([tenantId, propertyId])
  @@index([guestSubmissionId])
}

model Guest {
  id                                   String   @id @default(uuid())
  passengerCardId                      String
  /// Denormalized for authz / querying without joining.
  tenantId                             String
  propertyId                           String
  guestType                            String
  roleOnCard                           String
  firstName                            String
  lastName                             String
  /// Nullable: persisted only when the guest is identified by date of birth. On
  /// the PIC path the birthdate is derived in memory and never stored here.
  dateOfBirth                          DateTime? @db.Date
  citizenship                          String?
  isResidentInFinland                  Boolean?
  address                              String?
  documentType                         String?
  /// Envelope-encrypted JSON blob (see @gr/crypto encryptString). Never plaintext.
  documentNumberEncrypted              String?
  /// Reason the document number is blank: RESIDENT_IN_FINLAND | HAS_FINNISH_PIC | NORDIC_CITIZEN.
  documentNumberNotApplicableReason    String?
  /// Envelope-encrypted Finnish Personal Identity Code. Never plaintext.
  finnishPersonalIdentityCodeEncrypted String?
  email                                String?
  phoneE164                            String?
  isAdult                              Boolean
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime @updatedAt

  passengerCard PassengerCard @relation(fields: [passengerCardId], references: [id], onDelete: Cascade)

  @@index([passengerCardId])
}

/// One signature per passenger card. signatureEncrypted is nullable so PR2 can wipe
/// it after embedding the PNG into the final PDF, without needing to delete the row.
model PassengerCardSignature {
  id                  String   @id @default(uuid())
  passengerCardId     String   @unique
  /// Denormalized for authz / querying without joining.
  tenantId            String
  propertyId          String
  /// encryptString output of base64-encoded PNG bytes. Never the raw PNG.
  signatureEncrypted  String?
  signatureSha256     String
  signedAt            DateTime @default(now())
  signedIpHash        String?
  signedUserAgentHash String?
  createdAt           DateTime @default(now())

  passengerCard PassengerCard @relation(fields: [passengerCardId], references: [id], onDelete: Cascade)
}

/// Placeholder PDF generation job. PR1 only creates PENDING rows.
/// PR2 owns PENDING → PROCESSING → COMPLETED/FAILED via generatePdfForPassengerCard.
model PdfJob {
  id              String       @id @default(uuid())
  passengerCardId String       @unique
  tenantId        String
  propertyId      String
  status          PdfJobStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  passengerCard PassengerCard @relation(fields: [passengerCardId], references: [id], onDelete: Cascade)
}

/// One encrypted PDF per passenger card. Ciphertext is AES-256-GCM with a
/// per-PDF DEK wrapped by the KMS; the AAD binds tenant/property/batch/card.
model EncryptedPdf {
  id                 String   @id @default(uuid())
  passengerCardId    String   @unique
  /// = guestSubmissionId (the registration batch this card belongs to).
  batchId            String
  tenantId           String
  propertyId         String
  storageProvider    String
  blobPath           String
  encryptedDekBase64 String
  ivBase64           String
  authTagBase64      String
  aadJson            String
  kekKeyId           String
  algorithm          String
  sha256Ciphertext   String
  createdAt          DateTime @default(now())

  passengerCard PassengerCard @relation(fields: [passengerCardId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([batchId])
}

model AuditLog {
  id            String      @id @default(uuid())
  tenantId      String?
  actorType     ActorType
  actorId       String?
  action        AuditAction
  resourceType  String
  resourceId    String?
  /// SHA-256 hex of the client IP — raw IPs are never stored.
  ipHash        String?
  /// SHA-256 hex of the user agent — raw user agents are never stored.
  userAgentHash String?
  metadataJson  String?
  createdAt     DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}
