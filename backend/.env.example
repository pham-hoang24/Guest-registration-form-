# ============================================================
# Guest Registration Platform — Backend Environment Variables
# ============================================================

# --- Azure SQL (leave SQL_SERVER blank to use InMemoryDb locally) ---
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=guestreg
# Set this to any non-empty value to force InMemoryDb even if SQL_SERVER is set:
# SQL_CONNECTION_STRING=

# --- Azure Key Vault ---
KEY_VAULT_URL=https://your-vault.vault.azure.net/
KEY_VAULT_KEY_NAME=guestreg-kek
KEY_VAULT_KEY_VERSION=

# --- Guest token ---
GUEST_TOKEN_SECRET=change-me-in-production
GUEST_TOKEN_AUD=guest-registration

# --- Owner JWT (HS256, MVP only — replace with OIDC/JWKS in production) ---
OWNER_JWT_SECRET=change-me-in-production

# --- Worker ---
WORKER_MAX_ATTEMPTS=5

# --- Storage (leave BLOB_ACCOUNT_URL blank to use InMemoryBlobStore locally) ---
# Renamed from AZURE_BLOB_CONNECTION_STRING / AZURE_BLOB_CONTAINER. Update any
# existing deployment scripts or CI variables accordingly.
BLOB_ACCOUNT_URL=https://youraccount.blob.core.windows.net
BLOB_CONTAINER=encrypted-pdfs

# --- Service Bus (Managed Identity — no connection string needed) ---
# Set SERVICE_BUS_NAMESPACE to enable Azure Service Bus; leave blank for in-memory (local dev / tests).
# API principal needs: "Azure Service Bus Data Sender" role on the queue.
# Worker principal needs: "Azure Service Bus Data Receiver" role on the queue.
SERVICE_BUS_NAMESPACE=your-namespace.servicebus.windows.net
SERVICE_BUS_QUEUE=submission-jobs

# --- PDF size limit (bytes, default 10 MB) ---
MAX_PDF_BYTES=10485760
