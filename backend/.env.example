# ============================================================
# Guest Registration Platform — Backend Environment Variables
# ============================================================

# --- Azure SQL (leave SQL_SERVER blank to use InMemoryDb locally) ---
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=guestreg
# Set this to any non-empty value to force InMemoryDb even if SQL_SERVER is set:
# SQL_CONNECTION_STRING=

# --- Azure Key Vault ---
KEY_VAULT_URL=https://your-vault.vault.azure.net/
KEY_VAULT_KEY_NAME=guestreg-kek
KEY_VAULT_KEY_VERSION=

# --- Guest token ---
GUEST_TOKEN_SECRET=change-me-in-production
GUEST_TOKEN_AUD=guest-registration

# --- Owner JWT (HS256, MVP only — replace with OIDC/JWKS in production) ---
OWNER_JWT_SECRET=change-me-in-production

# --- Worker ---
WORKER_MAX_ATTEMPTS=5

# --- Storage ---
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=guest-reg-pdfs

# --- Service Bus ---
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=submission-jobs

# --- PDF size limit (bytes, default 10 MB) ---
MAX_PDF_BYTES=10485760
